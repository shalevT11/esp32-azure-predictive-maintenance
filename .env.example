# Copy to .env and fill in. NEVER commit the real .env.
# Backend
PORT=3000

# Azure IoT Hub — Event Hub-compatible endpoint (backend consumer)
IOTHUB_EVENTHUB_CONN_STRING=
IOTHUB_EVENTHUB_NAME=
IOTHUB_CONSUMER_GROUP=$Default

# TimescaleDB / Postgres
DATABASE_URL=postgres://user:pass@localhost:5432/pdm

# AI anomaly (optional until Stage 4)
GEMINI_API_KEY=
AZURE_AI_ENDPOINT=
